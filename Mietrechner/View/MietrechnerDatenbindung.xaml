<Window
    x:Class="WPFAutovermietung.Finanzrechner.View.MietrechnerDatenbindung"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFAutovermietung.Finanzrechner.View"
    mc:Ignorable="d"
    Title="MietrechnerDatenbindung"
    Height="600"
    Width="900">
    <Grid Background= "LightGray">

        <Label Content="Tagespreis / €" Margin="10,10,0,0"
               Foreground="Gray" FontSize="18"/>

        <Slider Minimum="10" Maximum="1000"
                TickFrequency="20"
                IsSnapToTickEnabled="True"
                Value="{Binding Tagespreis}"
                Margin="10,50,10,0"/>

        <Label Content="Vollkasko | 15€ / Tag" Margin="10,90,0,0"
               Foreground="Gray" FontSize="18"/>

        <CheckBox Margin="10,130, 10, 0"
                  IsChecked="{Binding Vollkasko, Mode=TwoWay}"></CheckBox>
        
        <Label Content="Mietdauer (Tage)" Margin="10,170,0,0"
               Foreground="Gray" FontSize="18"/>

        <Slider Minimum="1" Maximum="60"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding Mietdauer}"
                Margin="10,210,10,0"/>

        <Label Content="Rabatt (%)" Margin="200, 90, 0,0"
               Foreground="Gray" FontSize="18"/>
        
        <Slider Minimum="0" Maximum="100"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding Rabatt, Mode=TwoWay}"
                Margin="200,130,10,0"
                />
        
        
        <Expander Header="Daten"
          Margin="20,260,0,0"
          Width="520"
          Height="160"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Background="DarkGray">

            <Grid Margin="10" Background="#FFF1E7E7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mietpreis -->
                <Label Content="Mietpreis"
               Grid.Row="0" Grid.Column="0"/>
                <TextBlock Text="{Binding Tagespreis, StringFormat={}{0:F0} €}"
                   Grid.Row="0" Grid.Column="1"/>

                <!-- Vollkasko -->
                <Label Content="Vollkasko"
               Grid.Row="1" Grid.Column="0"/>
                <TextBlock Text="{Binding Vollkasko, StringFormat={}{0:F1} }"
                   Grid.Row="1" Grid.Column="1"/>

                <!-- Mietdauer -->
                <Label Content="Mietdauer"
               Grid.Row="2" Grid.Column="0"/>
                <TextBlock Text="{Binding Mietdauer, StringFormat={}{0} Tage}"
                   Grid.Row="2" Grid.Column="1"/>
                
                <!-- Rabatt -->
                <Label Content="Rabatt"
                       Grid.Row="3" Grid.Column="0"
                       />
                <TextBlock Text="{Binding Rabatt, StringFormat={}{0:F1} %}" Grid.Row="3" Grid.Column="1"></TextBlock>
            </Grid>
        </Expander>



        <TextBlock Text="{Binding Ergebnis}"
                   Margin="550,260,0,0"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>
    </Grid>
</Window>

<Window x:Class="WPFAutovermietung.Mietrechner"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eingabe" Height="170" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="txtFrage"
                       Text="Bitte Wert eingeben:"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtAntwort" Height="25"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="Abbrechen" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
